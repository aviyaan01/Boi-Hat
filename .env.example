# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookmarket?schema=public

# Redis (BullMQ queue & caching)
REDIS_URL=redis://localhost:6379

# Search (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey123

# Auth (JWT & Email Verification)
JWT_ACCESS_SECRET=super_secret_jwt_access_key_dhaka_boi_hat_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_dhaka_boi_hat_2026
OTP_DEV_MODE=true # Legacy phone OTP dev flag
ALLOW_DEV_CODE=true # In development, returns dev_code in response for automated testing

# Email SMTP Provider (Required in production; console logger fallback in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="বই-হাট <no-reply@boihat.com>"

# SMS Provider (e.g. Greenweb, SSL Wireless, MimSMS - optional in dev, required in production)
SMS_PROVIDER_API_KEY=

# Images (Cloudinary signed uploads)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (SSLCommerz)
SSLCOMMERZ_STORE_ID=test_store
SSLCOMMERZ_STORE_PASSWORD=test_password
SSLCOMMERZ_SANDBOX=true

# Push Notifications (Firebase FCM)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Monitoring
SENTRY_DSN=

# App Configuration
PORT=4000
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="Boi-Hat"
NODE_ENV=development

