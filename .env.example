# ==============================================================================
# Boi-Hat Production & Development Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME
# ------------------------------------------------------------------------------
# Runtime environment: 'development' or 'production'
# In production, Prisma+PostgreSQL is strictly required, in-memory mocks are disabled.
NODE_ENV=development

# Port where NestJS API listens (Render provides $PORT automatically)
PORT=4000
API_PORT=4000

# Permitted CORS origins (comma-separated, or '*' for public access)
CORS_ORIGINS="*"

# ------------------------------------------------------------------------------
# 2. DATABASE (Neon Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon pooled connection string (port 5432 or with ?sslmode=require)
# Used at runtime by Prisma client queries with PgBouncer connection pooling.
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Neon direct connection string (unpooled, port 5432)
# Required by Prisma CLI for DDL migrations (prisma migrate deploy).
DIRECT_URL="postgresql://user:password@ep-direct.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# In production: MUST be distinct, cryptographically random strings >= 32 characters.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="generate_at_least_32_characters_random_hex_string_for_access"
JWT_REFRESH_SECRET="generate_at_least_32_characters_different_random_hex_refresh"

# Set to true ONLY in local development to return test OTP codes in API responses.
# In production, must be false or omitted.
ALLOW_DEV_CODE="false"

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH (Brevo HTTPS API - Recommended for Render)
# ------------------------------------------------------------------------------
# Provider: 'brevo' (default in production), 'smtp', or 'console' (dev logger)
# Render blocks outbound SMTP ports 25, 465, 587; Brevo uses HTTPS API (port 443).
EMAIL_PROVIDER=brevo

# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender email address registered in your Brevo account
BREVO_SENDER_EMAIL="no-reply@boihat.com"

# Optional SMTP fallback (only used if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="বই-হাট <no-reply@boihat.com>"

# ------------------------------------------------------------------------------
# 5. IMAGE STORAGE (Cloudinary CDN)
# ------------------------------------------------------------------------------
# Provider: 'cloudinary' (production) or 'local' (development disk writes)
STORAGE_PROVIDER=cloudinary

# Get credentials from Cloudinary Console Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 6. INITIAL ADMIN ACCOUNT SEEDING
# ------------------------------------------------------------------------------
# Used by: npm --workspace=@boi-hat/api run db:seed:admin
ADMIN_EMAIL="admin@boihat.com"
ADMIN_USERNAME="boihat_admin"
ADMIN_NAME="Boi-Hat System Administrator"
