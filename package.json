{
  "name": "boi-hat-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace=@boi-hat/api run start:dev",
    "dev:web": "npm --workspace=@boi-hat/web run dev",
    "build:types": "npm --workspace=@boi-hat/shared-types run build",
    "build": "npm run build:types && npm --workspace=@boi-hat/api run build && npm --workspace=@boi-hat/web run build",
    "migrate": "npm --workspace=@boi-hat/api run prisma:migrate",
    "seed": "npm --workspace=@boi-hat/api run prisma:seed",
    "test": "npm --workspace=@boi-hat/api run test",
    "test:e2e": "npx playwright test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
